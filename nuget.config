<?xml version="1.0" encoding="utf-8"?>
<!--
  nuget.org only. CS2MenuManager is the upstream package: it is only a compile-time
  reference (the DLL is stripped from the release and provided at runtime by
  MenuManagerCore), so it just has to match the API of the MenuManagerCore on the server.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
